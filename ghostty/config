# Font
font-family = ComicShannsMono Nerd Font Mono
font-size = 16

# Transparency & frosted glass
background-opacity = 0.72
background-blur-radius = 20

# Bold uses bright palette (matches iTerm2 "Use Bright Bold")
bold-is-bright = true

# Colors (Monokai Pro)
background = #2D2A2E
foreground = #FCFCFA
cursor-color = #FCFCFA
selection-background = #434144
selection-foreground = #FCFCFA

# ANSI palette
# green(2/10) and yellow(3/11) are P3 originals, boosted to compensate for sRGB gamut loss
palette = 0=#403E41
palette = 1=#FF6188
palette = 2=#87F299
palette = 3=#F0EF96
palette = 4=#FC9867
palette = 5=#AB9DF2
palette = 6=#78DCE8
palette = 7=#FCFCFA
palette = 8=#727072
palette = 9=#FF6188
palette = 10=#87F299
palette = 11=#F0EF96
palette = 12=#FC9867
palette = 13=#AB9DF2
palette = 14=#78DCE8
